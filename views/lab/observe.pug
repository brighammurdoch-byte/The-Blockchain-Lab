extends ../layout

block config
  - bodyClass = 'lab-app'

block extra_css
  link(rel='stylesheet', href='/stylesheets/lab-theme.css?v=p1fix1')

block content
  .container-fluid
    .row.lab-session-banner
      .col-md-12.mb-3
        .panel.panel-info
          .panel-heading
            h3.panel-title Session Information
          .panel-body
            .row
              .col-md-12
                p
                  strong Session Code:
                  br
                  code#sessionCode.text-center(style="display: block; font-size: 1.5em; padding: 10px; background: #f5f5f5;") #{sessionId}

    .row
      .col-md-3
        .panel.panel-success
          .panel-heading
            h3.panel-title Your Wallet
          .panel-body
            .well
              p.text-center
                strong Your Address
                br
                code.small#yourAddress(style="word-break: break-all;") Loading...
                script.
                  (function() {
                    try {
                      var sid = (window.LabPaths && LabPaths.getSessionIdFromLocation()) || window.location.pathname.split('/').pop();
                      var uid = localStorage.getItem('userId_' + sid);
                      if (!uid) {
                        uid = 'user_' + Math.random().toString(36).substr(2, 9);
                        localStorage.setItem('userId_' + sid, uid);
                      }
                      var el = document.getElementById('yourAddress');
                      if (el) el.textContent = uid;
                    } catch (err) {}
                  })();
            .well
              p.text-center
                strong Wallet display name
              input.form-control#nodeName(type="text", placeholder="Optional name shown to others", maxlength="50", style="text-align: center; margin-bottom: 10px;")
              button.btn.btn-xs.btn-primary.btn-block#setNodeNameBtn(type="button") Save name
            .well
              p.text-center
                strong Balance
                br
                h3#yourBalance 0
                span.js-unit-label coins
              small.text-muted.js-endowment-note(style="display:block; text-align:center; margin-top: 6px;")
                | Starts with 100 demo coins.

        .panel.panel-info
          .panel-heading
            h3.panel-title Network Overview
          .panel-body
            .well
              p.text-center
                strong Block Height
                br
                h3#blockHeight 0
            .well
              p.text-center
                strong Participants
                br
                h3#participantCount 0
            .well
              p.text-center
                strong Network Hashrate
                br
                h4#totalHashrate 0 H/s
            .well
              p.text-center
                strong Last Block
                br
                h4#lastBlockTime 0s ago

        .panel.panel-default
          .panel-heading
            h3.panel-title Active Participants
          .panel-body(style="max-height: 400px; overflow-y: auto;")
            ul#participantList.list-group
              li.list-group-item.text-muted Waiting for participants...

        .panel.panel-default
          .panel-heading
            h3.panel-title Send Transaction
          .panel-body
            form#transactionForm
              .form-group
                label(for="recipientAddress") Recipient address
                input.form-control#recipientAddress(type="text", placeholder="Participant address (user ID)", autocomplete="off", title="Enter the other participant's address exactly as shown in the list")
              .form-group
                label Amount
                input.form-control#transactionAmount(type="number", min="0.01", step="0.01", placeholder="Amount")
              button.btn.btn-primary.btn-block(type="submit") Send Transaction

        .panel.panel-default
          .panel-heading
            h3.panel-title Admin Settings
          .panel-body
            dl.lab-settings-list
              dt Leading Zeros
              dd#adminDifficultyLeading N/A
              dt Secondary
              dd#adminDifficultySecondary N/A
              dt Mining Reward
              dd#adminMiningReward N/A
              dt Parameters
              dd#adminParams
                span.label.label-success Unlocked

      .col-md-9
        .panel.panel-default
          .panel-heading
            h3.panel-title Blockchain
          .panel-body(style="max-height: 800px; overflow-y: auto;")
            div#blockchainView
              p.text-center.text-muted Loading blockchain...

        .panel.panel-default
          .panel-heading
            h3.panel-title Mempool
              |  
              span.label.label-default#mempoolCountBadge 0
          .panel-body(style="max-height: 300px; overflow-y: auto;")
            p.small.text-muted(style="margin-top:0;") Pending transactions waiting to be mined into a block.
            table.table.table-striped.table-hover(style="margin-bottom:0;")
              thead
                tr
                  th From
                  th To
                  th Amount
                  th Time
              tbody#pendingTransactions
                tr
                  td(colspan="4").text-center.text-muted No pending transactions

  script(src="/javascripts/lib/p2pt.bundle.js?v=fixrelay")
  script(src="/javascripts/lib/mqtt.min.js?v=mqtt1")
  script(src="/javascripts/lab/labPaths.js?v=p2fix1")
  script(src="/javascripts/network/SimulatedAdminRelayTransport.js?v=fixrelay")
  script(src="/javascripts/network/MqttAdminRelayTransport.js?v=p2fix1")
  script(src="/javascripts/network/P2PAdminRelayTransport.js?v=tiphb1")
  script(src="/javascripts/network/AdminRelayCoordinator.js?v=mqttslim1")
  script(src="/javascripts/network/Persistence.js?v=fixrelay")
  script(src="/javascripts/network/RelayBlockchainState.js?v=p2fix2")
  script(src="/javascripts/network/NetworkManager.js?v=p1fix1")
  script(src="/javascripts/lab/sessionProbe.js?v=p1fix1")
  script(src="/javascripts/lab/chainDisplay.js?v=p1fix1")
  script(src="/javascripts/lab/observe.js?v=p2fix2")
