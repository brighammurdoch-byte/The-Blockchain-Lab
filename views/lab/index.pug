extends ../layout

block config
  - bodyClass = 'lab-app'

block extra_css
  link(rel='stylesheet', href='/stylesheets/lab-theme.css?v=p3fix1')

block content
  .container.lab-landing
    .lab-landing__brand
      span.lab-landing__eyebrow Classroom simulation
      h1 The Blockchain Lab
      p.lead
        | Run a live Proof-of-Work network with your class — mine blocks, move coins,
        | and watch consensus form in real time.

    .lab-split
      .lab-action.lab-action--instructor
        h2 Instructor
        p Create a session. Your browser becomes the hub — share the code or QR with students.
        button.btn.btn-primary.btn-lg.btn-block#createSessionBtn Create Session
        p(style="margin-top:14px;margin-bottom:0;")
          small.text-muted Keep the admin tab open for the whole class period.

      .lab-action.lab-action--student
        h2 Student
        p Join with a session code (or a shared link / QR). Choose miner or wallet.
        form#joinForm
          #joinError.alert.alert-danger(style="display:none; margin-bottom:12px;")
          .form-group
            label(for="joinCode") Session code
            input.form-control(type="text", id="joinCode", name="joinCode", placeholder="ABC123", maxlength="6", autocomplete="off")
          .form-group
            label(for="roleSelect") Role
            select.form-control#roleSelect(name="role")
              option(value="participant" selected) Miner — find blocks
              option(value="observer") Wallet — watch &amp; send
          button.btn.btn-success.btn-lg.btn-block(type="submit") Join as Miner
          button.btn.btn-default.btn-block#joinCancelBtn(type="button" style="display:none; margin-top:8px;") Cancel
          script.
            (function () {
              try {
                var m = new URLSearchParams(window.location.search || '').get('joinError');
                var el = document.getElementById('joinError');
                if (m && el) { el.textContent = m; el.style.display = 'block'; }
              } catch (e) {}
            })();

    .lab-about
      h3 What you’ll demonstrate
      ul.lab-concept-tags
        li Proof of Work
        li Consensus
        li Transactions
        li 51% attacks
        li Hard forks
      p
        a(href="/bitcoin") Bitcoin classroom
        |  — same admin + miner/wallet nodes, with a 50 BTC subsidy and halvings.
        |  ·
        |
        a(href="/ethereum") Ethereum rules lab
        |  — optional Solidity-shaped editor.
      p(style="margin-bottom:0;color:#5c7380;font-size:13px;")
        | Based on
        |
        a(href="http://andersbrownworth.com/blockchain/") Anders Brownworth’s Blockchain Demo
        | . No backend session server required — coordination runs in the browsers.
        |
        | Want to help improve the lab?
        |
        a(
          href="https://github.com/brighammurdoch-byte/The-Blockchain-Lab"
          target="_blank"
          rel="noopener noreferrer"
        ) Contribute on GitHub
        | .

  script(src="/javascripts/lib/p2pt.bundle.js?v=fixrelay")
  script(src="/javascripts/lib/mqtt.min.js?v=mqtt1")
  script(src="/javascripts/lab/labPaths.js?v=p2fix6")
  script(src="/javascripts/network/SimulatedAdminRelayTransport.js?v=p1fix1")
  script(src="/javascripts/network/MqttAdminRelayTransport.js?v=p2fix1")
  script(src="/javascripts/network/P2PAdminRelayTransport.js?v=mobjoin1")
  script(src="/javascripts/network/AdminRelayCoordinator.js?v=p4fix1")
  script(src="/javascripts/network/Persistence.js?v=p2fix4")
  script(src="/javascripts/network/RelayBlockchainState.js?v=p4fix2")
  script(src="/javascripts/network/NetworkManager.js?v=p2fix4")
  script(src="/javascripts/lab/sessionProbe.js?v=p1fix1")
  script(src="/javascripts/lab/landing.js?v=p2fix4")
