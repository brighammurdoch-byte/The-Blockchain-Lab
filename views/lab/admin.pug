extends ../layout

block config
  - bodyClass = 'lab-app'

block extra_css
  link(rel='stylesheet', href='/stylesheets/lab-theme.css?v=labui1')

block content
  .container-fluid
    .row.lab-session-banner
      .col-md-12.mb-3
        .panel.panel-info
          .panel-heading
            h3.panel-title Session Information
          .panel-body
            .row
              .col-sm-7
                p
                  strong Session Code:
                  br
                  code#sessionCode.text-center(style="display: block; font-size: 2em; letter-spacing: 0.12em; padding: 12px; background: #f5f5f5;") #{sessionId}
                p
                  strong Share link (laptops / chat):
                  .input-group
                    input.form-control#joinShareLink(type="text", readonly, value="", style="font-size: 12px;")
                    span.input-group-btn
                      button.btn.btn-default#copyJoinLinkBtn(type="button") Copy
                small.text-muted Students open the link, pick Miner or Wallet, then Join. <strong>Keep this admin tab open</strong> — it is the classroom hub. For phones, create the session on the <strong>GitHub Pages</strong> URL (not localhost).
              .col-sm-5.text-center
                strong#joinQrLabel Scan to join (phones)
                br
                canvas#joinQrCanvas(width="180", height="180", style="margin-top: 8px; border: 1px solid #ddd; border-radius: 4px; background: #fff;")
                p.small.text-muted(style="margin-top: 8px;") Opens the lab with this session code filled in.

    .row
      .col-md-3
        .panel.panel-primary
          .panel-heading
            h3.panel-title Network Controls
          .panel-body
            .form-group
              label Difficulty (Leading Zeros):
              input.form-control#difficultyLeading(type="range", min="1", max="6", value="4")
              small.form-text.text-muted Current: 
              strong#difficultyLeadingValue 4

            .form-group
              label Difficulty (Secondary):
              input.form-control#difficultySecondary(type="range", min="0", max="15", value="8")
              small.form-text.text-muted Current: 0x
              strong#difficultySecondaryValue 8

            .form-group
              label Mining Reward (coins):
              input.form-control#miningReward(type="number", min="1", max="100", value="10")

            .form-group
              label Network Mode:
              select.form-control#networkModeSelect
                option(value="admin-relay" selected) Admin-hosted (recommended)
                option(value="p2p") Full P2P (mesh gossip)
              small.form-text.text-muted#networkModeHelp Admin-hosted is most reliable for class. Full P2P shows decentralized gossip.
              p#connectionStatus(style="margin-top:8px;")
                span.label.label-default#peerCountBadge Peers: 0
                |  
                small.text-muted Keep this tab open — you are the classroom hub.

            .form-group
              .checkbox
                label
                  input(type="checkbox", id="lockParameters")
                  | Lock parameters (no runtime changes)

            button.btn.btn-primary.btn-block#updateSettingsBtn Update Settings
            button.btn.btn-danger.btn-block#toggleNetworkBtn.mt-2 Pause Network

        .panel.panel-success
          .panel-heading
            h3.panel-title Your Wallet
          .panel-body
            .well(style="margin-bottom: 12px;")
              p.text-center(style="margin-bottom: 6px;")
                strong Your Address
              code.small#yourAddress(style="display:block; word-break: break-all; text-align: center;") Loading...
              button.btn.btn-xs.btn-default.btn-block#copyAdminAddressBtn(type="button", style="margin-top: 8px;") Copy address
            .well(style="margin-bottom: 12px;")
              p.text-center(style="margin-bottom: 4px;")
                strong Balance
              h3.text-center#yourBalance(style="margin: 0;") 0
              p.text-center.text-muted(style="margin: 0;") coins
              small.text-muted(style="display:block; text-align:center; margin-top: 6px;")
                | Starts with 100 demo coins so you can fund students.
            form#transactionForm
              .form-group
                label(for="recipientAddress") Recipient address
                input.form-control#recipientAddress(type="text", placeholder="Student address", autocomplete="off")
              .form-group
                label(for="transactionAmount") Amount
                input.form-control#transactionAmount(type="number", min="0.01", step="0.01", placeholder="Amount")
              button.btn.btn-primary.btn-block(type="submit") Send Transaction
              small.form-text.text-muted Transactions wait in the mempool until a miner includes them in a block.

        .panel.panel-warning
          .panel-heading
            h3.panel-title Attack Simulation
          .panel-body
            .form-group
              label Simulate 51% Attack:
              select.form-control#attackerSelect
                option(value="") Select attacker...
                option(value="none") None
              input.form-control#attackBlockIndex(type="number", min="0", placeholder="From block #", style="display: none;")
            button.btn.btn-danger.btn-block#startAttackBtn(disabled) Initiate Attack
            small.form-text.text-muted Only enabled if attacker has 51% hashrate

      .col-md-9
        .panel.panel-default
          .panel-heading
            h3.panel-title Network Topology & Block Propagation
          .panel-body
            svg#networkVisualizationSvg(width="100%", height="500", style="border: 1px solid #ddd; border-radius: 4px; background: #f9f9f9;")
            .mt-2.text-center#networkTopologyLegend
              div(style="margin-bottom: 8px;")
                strong(style="font-size: 12px;") Role shapes
                span.legend-item.ml-3
                  span(style="display: inline-block; width: 14px; height: 14px; background: #9E9E9E; border: 2px solid #333; transform: rotate(45deg); margin-right: 8px; vertical-align: -2px;")
                  | Admin
                span.legend-item.ml-3
                  span(style="display: inline-block; width: 14px; height: 14px; background: #9E9E9E; border: 2px solid #333; border-radius: 50%; margin-right: 6px; vertical-align: -2px;")
                  | Miner
                span.legend-item.ml-3
                  span(style="display: inline-block; width: 14px; height: 14px; background: #9E9E9E; border: 2px solid #333; margin-right: 6px; vertical-align: -2px;")
                  | Wallet
              div
                strong(style="font-size: 12px;") Status colors
                span.legend-item.ml-3
                  span(style="background: #4CAF50; display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 5px;")
                  | Mining
                span.legend-item.ml-3
                  span(style="background: #FFC107; display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 5px;")
                  | Block Found
                span.legend-item.ml-3
                  span(style="background: #2196F3; display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 5px;")
                  | Receiving
                span.legend-item.ml-3
                  span(style="background: #26A69A; display: inline-block; width: 12px; height: 12px; transform: rotate(45deg); margin-right: 7px; vertical-align: -1px;")
                  | Sending / Tx
                span.legend-item.ml-3
                  span(style="background: #f0f0f0; border: 2px solid #999; display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 5px;")
                  | Idle
              div(style="margin-top: 6px;")
                strong(style="font-size: 12px;") On the wires
                span.legend-item.ml-3
                  span(style="background: #FFC107; display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 5px; border: 1px solid #F57F17;")
                  | Block packet
                span.legend-item.ml-3
                  span(style="background: #26A69A; display: inline-block; width: 10px; height: 10px; transform: rotate(45deg); margin-right: 7px; vertical-align: -1px; border: 1px solid #004D40;")
                  | Transaction packet

        .panel.panel-default
          .panel-heading
            h3.panel-title Network Statistics
          .panel-body
            .row.text-center
              .col-md-3
                h4#blockHeight 0
                small Block Height
              .col-md-3
                h4#participantCount 0
                small Participants
              .col-md-3
                h4#totalHashrate 0 H/s
                small Network Hashrate
              .col-md-3
                h4#avgBlockTime —
                small Avg Block Time
            .row.text-center(style="margin-top: 10px;")
              .col-md-3
                h4#lastBlockTime 0s
                small Since Last Block

        .panel.panel-default
          .panel-heading
            h3.panel-title Node Names & Info
          .panel-body
            table.table.table-striped.table-hover(style="font-size: 12px;")
              thead
                tr
                  th Node ID
                  th Display Name
                  th Status
              tbody#nodeNamesList
                tr
                  td(colspan="3").text-center.text-muted Waiting for miners to join...

        .panel.panel-default
          .panel-heading
            h3.panel-title.pull-left Participants
            .clearfix
          .panel-body
            table.table.table-striped.table-hover
              thead
                tr
                  th User ID
                  th Role
                  th Blocks Mined
                  th Balance
                  th Hashrate
              tbody#participantsList
                tr
                  td(colspan="5").text-center No participants yet

        .panel.panel-default
          .panel-heading
            h3.panel-title.pull-left Mempool
              |  
              span.label.label-default#mempoolCountBadge 0
            .clearfix
          .panel-body(style="max-height: 260px; overflow-y: auto;")
            p.small.text-muted(style="margin-top:0;") Pending transactions waiting for the next block. All roles see this same mempool.
            table.table.table-striped.table-hover(style="margin-bottom:0;")
              thead
                tr
                  th From
                  th To
                  th Amount
                  th Time
              tbody#pendingTransactions
                tr
                  td(colspan="4").text-center.text-muted No pending transactions

        .panel.panel-default
          .panel-heading
            h3.panel-title.pull-left Blockchain
            .clearfix
          .panel-body(style="max-height: 600px; overflow-y: auto;")
            div#blockchainView
              p.text-center.text-muted Loading blockchain...

  .modal.fade#attackWarningModal(tabindex="-1", role="dialog")
    .modal-dialog
      .modal-content
        .modal-header
          button.close(type="button", data-dismiss="modal")
            span &times;
          h4.modal-title WARNING: 51% Attack in Progress
        .modal-body
          p.text-danger A participant has achieved 51% of network hashrate and initiated an attack!
          p This is simulating a real blockchain attack where the attacker can:
          ul
            li Create a fork in the chain
            li Potentially reverse transactions
            li Double-spend coins
          p The original chain is shown in red, the attack fork in yellow.
        .modal-footer
          button.btn.btn-secondary(type="button", data-dismiss="modal") Close

  script(src="/javascripts/lib/qrcode.min.js?v=labqr2")
  script(src="/javascripts/lib/p2pt.bundle.js?v=fixrelay")
  script(src="/javascripts/lib/mqtt.min.js?v=mqtt1")
  script(src="/javascripts/lab/labPaths.js?v=fixrelay")
  script(src="/javascripts/network/SimulatedAdminRelayTransport.js?v=fixrelay")
  script(src="/javascripts/network/MqttAdminRelayTransport.js?v=pause2")
  script(src="/javascripts/network/P2PAdminRelayTransport.js?v=mobjoin1")
  script(src="/javascripts/network/AdminRelayCoordinator.js?v=mempool1")
  script(src="/javascripts/network/Persistence.js?v=fixrelay")
  script(src="/javascripts/network/RelayBlockchainState.js?v=txonce1")
  script(src="/javascripts/network/NetworkManager.js?v=mqtt1")
  script(src="/javascripts/lab/chainDisplay.js?v=name1")
  script(src="/javascripts/lab/networkVisualization.js?v=topomesh1")
  script(src="/javascripts/lab/admin.js?v=pause2")
