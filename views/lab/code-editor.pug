extends ../layout

block config
  - bodyClass = 'lab-app'

block extra_css
  link(rel='stylesheet', href='/stylesheets/lab-theme.css?v=labui1')

block content
  .container-fluid
    .row
      // Code Editor Section (70% width)
      .col-md-7
        .panel.panel-primary
          .panel-heading
            h3.panel-title
              i.glyphicon.glyphicon-edit
              | &nbsp; Validator Code Editor
            small.pull-right
              span#codeStatus
              =  " "
              span.label.label-success Original

          .panel-body
            .form-group
              label
                strong BlockValidator.js
              p.text-muted
                small
                  | This is the same 
                  code blockValidator.js
                  |  your miner compiles and runs. Finance students can ignore this page. Coding students can change consensus here — Submit applies it to every miner tab in this browser for the current session.
              .alert.alert-info(style="margin-bottom:12px;")
                strong How this runs:
                |  the browser cannot execute Node’s 
                code require('crypto')
                | . On Submit we compile this source in-page (same path as the miner tab) and replace your node’s validator. Other students still use their own copy unless they submit too.
              
              // Syntax highlighted code editor
              pre#codeEditor(style="height: 600px; border: 1px solid #ddd; padding: 10px;")
              
              p
                button#loadCode.btn.btn-info.btn-sm
                  i.glyphicon.glyphicon-refresh
                  | &nbsp;Load Code
                button.btn.btn-warning.btn-sm(onclick="resetCode()")
                  i.glyphicon.glyphicon-remove
                  | &nbsp;Reset to Original
                button#submitCode.btn.btn-success.btn-sm
                  i.glyphicon.glyphicon-ok
                  | &nbsp;Submit Modified Code
                button.btn.btn-danger.btn-sm(onclick="toggleDiff()")
                  i.glyphicon.glyphicon-list
                  | &nbsp;Show Changes

      // Learning Panel (30% width)
      .col-md-5
        // Key Functions Panel
        .panel.panel-info
          .panel-heading
            h4.panel-title Key Functions to Modify
          .panel-body
            .accordion#accordion
              .panel.panel-default
                .panel-heading
                  h5.panel-title
                    a(data-toggle="collapse" data-parent="#accordion" href="#validateHash")
                      code validateBlockHash()
                      |  - Proof-of-Work
                .panel-collapse.collapse(id="validateHash")
                  .panel-body
                    p
                      strong What it does:
                      | Checks if the block hash has the required number of leading zeros
                    
                    p
                      strong Experiment:
                      | Try changing 
                      code requiredLeadingZeros: 3
                      | to 4 or 2
                    
                    p
                      strong What happens:
                    ul
                      li 3 zeros: Normal mining difficulty
                      li 4 zeros: HARD FORK - incompatible with others
                      li 2 zeros: Soft fork - blocks still validate
                    
                    p
                      strong Educational value:
                      | Learn why Proof-of-Work difficulty is critical to blockchain security

              .panel.panel-default
                .panel-heading
                  h5.panel-title
                    a(data-toggle="collapse" data-parent="#accordion" href="#validateTx")
                      code validateTransaction()
                      |  - Double-Spend Prevention
                .panel-collapse.collapse(id="validateTx")
                  .panel-body
                    p
                      strong What it does:
                      | Verifies that users can't spend coins they don't have
                    
                    p
                      strong Experiment:
                      | Try removing the balance check to allow double-spending
                    
                    p
                      strong What happens:
                    ul
                      li Remove check: Can send infinite coins ✗
                      li Keep check: Transactions validated ✓
                    
                    p
                      strong Educational value:
                      | This is the fundamental security preventing coin duplication

              .panel.panel-default
                .panel-heading
                  h5.panel-title
                    a(data-toggle="collapse" data-parent="#accordion" href="#validateChain")
                      code validatePreviousHash()
                      |  - Chain Integrity
                .panel-collapse.collapse(id="validateChain")
                  .panel-body
                    p
                      strong What it does:
                      | Ensures each block links to the previous block
                    
                    p
                      strong Experiment:
                      | Try allowing ANY previous hash (remove the check)
                    
                    p
                      strong What happens:
                    ul
                      li Remove check: Chain breaks into fragments ✗
                      li Keep check: Chain stays linked ✓
                    
                    p
                      strong Educational value:
                      | This is the "chain" in "blockchain" - without it, anyone could reorganize history

        // Guided Demos Link
        .panel.panel-warning
          .panel-heading
            h4.panel-title Guided Demos
          .panel-body
            p Want to learn specific attack scenarios? Check out the guided demos:
            
            ul.list-group
              li.list-group-item
                a(href="#" onclick="viewDemo('hard-fork-difficulty')")
                  strong Hard Fork Demo
                br
                small Increase difficulty to 4 - see network split
              
              li.list-group-item
                a(href="#" onclick="viewDemo('attack-51-will-succeed')")
                  strong 51% Attack (Success)
                br
                small With majority power, override original chain
              
              li.list-group-item
                a(href="#" onclick="viewDemo('attack-double-spend')")
                  strong Double-Spend Attack
                br
                small Reverse transactions with majority hashrate

        // Code Status Panel
        .panel.panel-danger
          .panel-heading
            h4.panel-title Code Status
          .panel-body
            ul.list-unstyled
              li
                i.glyphicon.glyphicon-ok.text-success(id="statusOriginal")
                | &nbsp;
                span#statusOriginalText Using original validator code
              
              li
                i.glyphicon.glyphicon-remove.text-danger(id="statusModified" style="display:none;")
                | &nbsp;
                span#statusModifiedText
                  strong You modified your validator!
                  br
                  small Monitor the network for chain forks or consensus conflicts
              
              li
                i.glyphicon.glyphicon-warning-sign.text-warning(id="statusWaiting" style="display:none;")
                | &nbsp;
                span#statusWaitingText Waiting for code validation...

            p(id="networkStatus" style="margin-top: 10px;")
              small.text-muted No network changes detected

  // CodeMirror for syntax highlighting
  script(src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js")
  link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/atom-one-dark.min.css")

  script(src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.15.0/ace.min.js")
  script(src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.15.0/mode-javascript.min.js")
  script(src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.15.0/theme-monokai.min.js")
  script(src="/javascripts/lab/validatorBridge.js?v=vbridge1")

  script.
    // Initialize Ace Editor (pin CDN base so workers don't 404 under /lab/)
    if (window.ace && ace.config) {
      ace.config.set('basePath', 'https://cdnjs.cloudflare.com/ajax/libs/ace/1.15.0/');
      ace.config.set('workerPath', 'https://cdnjs.cloudflare.com/ajax/libs/ace/1.15.0/');
    }
    var editor = ace.edit("codeEditor");
    editor.setTheme("ace/theme/monokai");
    editor.session.setMode("ace/mode/javascript");
    editor.session.setUseWorker(false);
    editor.setFontSize(14);
    editor.setWrapBehavioursEnabled(true);

    var originalCode = "";
    var sessionId = "#{sessionId}";
    var userId = "#{userId || 'anonymous'}";

    function validatorCatalogUrl() {
      if (window.LabPaths && LabPaths.assetUrl) return LabPaths.assetUrl('/data/validator-code.json');
      return '/data/validator-code.json';
    }

    function demoCatalogUrl() {
      if (window.LabPaths && LabPaths.assetUrl) return LabPaths.assetUrl('/data/demos.json');
      return '/data/demos.json';
    }

    // Load validator code
    document.getElementById('loadCode').addEventListener('click', function() {
      fetch(validatorCatalogUrl())
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var code = data && data.code;
          if (code) {
            originalCode = code;
            editor.setValue(originalCode);
            document.getElementById('codeStatus').textContent = "Code loaded";
            updateStatus('original');
            return;
          }
          throw new Error('empty catalog');
        })
        .catch(function() {
          return fetch('/lab/validator-code')
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (data && data.success && data.code) {
                originalCode = data.code;
                editor.setValue(originalCode);
                document.getElementById('codeStatus').textContent = "Code loaded";
                updateStatus('original');
              } else {
                throw new Error((data && data.error) || 'Could not load validator');
              }
            });
        })
        .catch(function(err) {
          alert('Error loading code: ' + (err && err.message ? err.message : err));
        });
    });

    function currentSession() {
      if (sessionId && String(sessionId).trim()) return String(sessionId).trim().toUpperCase();
      return (window.LabPaths && LabPaths.getSessionIdFromLocation()) || '';
    }

    function applyLive(code, announce) {
      if (!window.ValidatorBridge) {
        alert('Validator bridge failed to load. Refresh the page.');
        return false;
      }
      var result = ValidatorBridge.applyToWindow(code, originalCode);
      if (!result.ok) {
        alert('Validator compile error: ' + result.error);
        return false;
      }
      if (result.empty) {
        ValidatorBridge.clear(currentSession());
      } else if (!result.skip) {
        ValidatorBridge.save(currentSession(), code);
      }
      updateStatus(result.isCustom ? 'modified' : 'original');
      if (announce) {
        var sid = currentSession();
        document.getElementById('networkStatus').innerHTML =
          '<strong style="color: orange;">Your miner rules are now MODIFIED.</strong> ' +
          (sid
            ? 'Session <code>' + sid + '</code> miner tabs in this browser will use this code (open or refresh a miner if it was already running).'
            : 'No session in the URL — this browser will apply the code to the next miner you join. Open a miner from a classroom session to use it live.');
      }
      return true;
    }

    // Submit modified code — same compile path as the miner tab
    document.getElementById('submitCode').addEventListener('click', function() {
      var modifiedCode = editor.getValue();
      if (modifiedCode === originalCode) {
        alert('You haven\'t made any changes to the code.');
        return;
      }
      if (!confirm('Apply this validator to your miner node? Other students keep their own rules unless they submit the same change.')) {
        return;
      }
      applyLive(modifiedCode, true);
    });

    function resetCode() {
      if (confirm('Reset validator code to original? Your modifications will be lost.')) {
        editor.setValue(originalCode);
        if (window.ValidatorBridge) ValidatorBridge.clear(currentSession());
        if (window.ValidatorBridge) ValidatorBridge.applyToWindow(originalCode, originalCode);
        updateStatus('original');
        document.getElementById('networkStatus').innerHTML = '<small class="text-muted">Using original validator code.</small>';
      }
    }

    function updateStatus(status) {
      document.getElementById('statusOriginal').style.display = status === 'original' ? 'inline' : 'none';
      document.getElementById('statusOriginalText').style.display = status === 'original' ? 'inline' : 'none';
      
      document.getElementById('statusModified').style.display = status === 'modified' ? 'inline' : 'none';
      document.getElementById('statusModifiedText').style.display = status === 'modified' ? 'inline' : 'none';
      
      document.getElementById('codeStatus').textContent = status === 'modified' ? 'MODIFIED' : 'Original';
      document.querySelector('span.label').className = status === 'modified' ? 'label label-danger' : 'label label-success';
    }

    function toggleDiff() {
      var current = editor.getValue();
      if (current === originalCode) {
        alert('No changes detected');
      } else {
        alert('You have modified the following functions:\n' + 
              '- Lines with red background show your changes');
      }
    }

    function viewDemo(demoName) {
      fetch(demoCatalogUrl())
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var list = (data && data.demos) || [];
          var demo = list.filter(function(d) { return d.id === demoName; })[0];
          if (!demo) {
            alert('Demo not found: ' + demoName);
            return;
          }
          var msg = (demo.name || demo.title || demoName) + '\n\n' +
                    (demo.setup && demo.setup.description ? demo.setup.description + '\n' : '') +
                    '\nOpen Guided Demos for the full walkthrough.';
          alert(msg);
        })
        .catch(function(err) {
          alert('Error loading demo: ' + (err && err.message ? err.message : err));
        });
    }

    function applyDemoFromQuery() {
      var params = new URLSearchParams(window.location.search || '');
      var demoId = params.get('demo');
      if (!demoId) return;
      fetch(demoCatalogUrl())
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var list = (data && data.demos) || [];
          var demo = list.filter(function(d) { return d.id === demoId; })[0];
          if (!demo) return;
          var box = document.getElementById('networkStatus');
          if (!box) return;
          box.innerHTML = '<strong>' + (demo.name || demo.title || demoId) + '</strong><br>' +
            (demo.setup && demo.setup.description ? demo.setup.description : 'Follow the code changes in the demo details.');
        })
        .catch(function() {});
    }

    // Load code on page load (prefer a previously submitted custom validator)
    window.addEventListener('load', function() {
      document.getElementById('loadCode').click();
      applyDemoFromQuery();
      setTimeout(function () {
        var saved = window.ValidatorBridge && ValidatorBridge.load(currentSession());
        if (saved && originalCode && saved.trim() !== originalCode.trim()) {
          editor.setValue(saved);
          applyLive(saved, true);
        }
      }, 400);
    });

    // WebSocket listener for network changes
    if (window.socket) {
      socket.on('validator-modified', function(data) {
        document.getElementById('networkStatus').innerHTML += 
          '<br><strong style="color: orange;">' + new Date().toLocaleTimeString() + 
          ':</strong> ' + data.message;
      });
    }
