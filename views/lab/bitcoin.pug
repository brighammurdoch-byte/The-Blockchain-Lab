extends ../layout

block config
  - bodyClass = 'lab-app'
  - page = 'bitcoin'

block extra_css
  link(rel='stylesheet', href='/stylesheets/lab-theme.css?v=p1fix1')

block content
  .container.lab-landing
    .lab-landing__brand
      span.lab-landing__eyebrow Bitcoin classroom
      h1 Bitcoin Lab
      p.lead
        | Same classroom as the main lab: an instructor hub, then nodes that mine
        | and send BTC. Subsidy starts at 50 BTC and halves every 21 blocks
        | (Core is 210,000 — scaled so a class can see a halving).

    .lab-split
      .lab-action.lab-action--instructor
        h2 Instructor
        p Create a Bitcoin session. Your browser is the hub — share the code or QR. Students join as miners or wallets.
        button.btn.btn-primary.btn-lg.btn-block#createSessionBtn Create Bitcoin Session
        p(style="margin-top:14px;margin-bottom:0;")
          small.text-muted Keep the admin tab open for the whole class period.

      .lab-action.lab-action--student
        h2 Student
        p Join with the session code (or the shared link / QR). Miners also have a wallet. Wallets watch and send.
        form#joinForm
          #joinError.alert.alert-danger(style="display:none; margin-bottom:12px;")
          .form-group
            label(for="joinCode") Session code
            input.form-control(type="text", id="joinCode", name="joinCode", placeholder="ABC123", maxlength="6", autocomplete="off")
          .form-group
            label(for="roleSelect") Role
            select.form-control#roleSelect(name="role")
              option(value="participant" selected) Miner — find blocks &amp; hold BTC
              option(value="observer") Wallet — watch &amp; send
          button.btn.btn-success.btn-lg.btn-block(type="submit") Join as Miner
          button.btn.btn-default.btn-block#joinCancelBtn(type="button" style="display:none; margin-top:8px;") Cancel
          script.
            (function () {
              try {
                var m = new URLSearchParams(window.location.search || '').get('joinError');
                var el = document.getElementById('joinError');
                if (m && el) { el.textContent = m; el.style.display = 'block'; }
              } catch (e) {}
            })();

    .lab-about
      h3 What this classroom shows
      ul.lab-concept-tags
        li Proof of Work
        li Block subsidy
        li Halving
        li Wallets &amp; transfers
        li Consensus
      p.alert.alert-warning(style="margin-top:16px;")
        strong This is not bitcoind.
        |
        | Students run a Bitcoin-
        em like
        |  classroom chain in the browser (50 BTC subsidy, halvings, the same hub/miner/wallet flow as the main lab). It is a teaching twin — not Bitcoin Core.
      p
        a(href="/lab") Main classroom lab
        |  ·
        |
        a(href="/bitcoin/rules") Optional C++-shaped rules editor
        |  (solo, not the class mesh)
      p(style="margin-bottom:0;color:#5c7380;font-size:13px;")
        | Keep the instructor tab open. Phones should join from the GitHub Pages URL, not localhost.

  script(src="/javascripts/lib/p2pt.bundle.js?v=fixrelay")
  script(src="/javascripts/lib/mqtt.min.js?v=mqtt1")
  script(src="/javascripts/lab/labPaths.js?v=p2fix3")
  script(src="/javascripts/network/SimulatedAdminRelayTransport.js?v=p1fix1")
  script(src="/javascripts/network/MqttAdminRelayTransport.js?v=p2fix1")
  script(src="/javascripts/network/P2PAdminRelayTransport.js?v=mobjoin1")
  script(src="/javascripts/network/AdminRelayCoordinator.js?v=p1fix1")
  script(src="/javascripts/network/Persistence.js?v=fixrelay")
  script(src="/javascripts/network/RelayBlockchainState.js?v=p2fix2")
  script(src="/javascripts/network/NetworkManager.js?v=p1fix1")
  script(src="/javascripts/lab/sessionProbe.js?v=p1fix1")
  script(src="/javascripts/lab/landing.js?v=p2fix3")
